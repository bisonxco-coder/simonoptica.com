APP_NAME=LensOrderWeb
APP_NAME_XML=LensOrderWEB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=2.1.2

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#--------LENSWARE VARIABLES--------#

MIX_BASE_URL=/
HTACCESS_VALUE=lwr
MIX_SHOP_CALL_PATH=/ShopLWR
MIX_SHOP_URL=https://lensware.dyndns.biz:28443

# Default language for first time
LOCALE=en

# LSS
SOAP_URL="https://lensware.dyndns.biz:35001"

# Javascript compilation id. Changing this will force browser cache reload
COMPILED_VERSION="202303081"

# Lens preview color
LENS_GRAPHICS_COLOR="darkblue"

# Route HomeSite(router/index.js); possible: orderBasket, newOrder, overview
#Default: newOrder
HOMESITE=overview

# Allowed languages. Commenting will show all available
# LOCALE_ENABLED=de,en,fr

# Navbar options visibility
#Default No
SHOW_USER_CONFIG=NO

#Default No
SHOW_SHOP_CONFIG=NO

#Default YES
SHOW_CHANGE_PASSWORD=YES

# Lens order types visibility in Basic Order. Store/modules/order.js Line 64
#Default YES
SHOW_FRAME_TO_COME=YES
#Default YES
SHOW_LENS_ORDER=YES
#Default NO
SHOW_BULK_ORDER=NO
#Default Yes
SHOW_COMPLETE_FRAME=YES
#Default Yes
SHOW_REMOTE_EDGING=YES

# Show Lensfilter in Product category
#Default YES
SHOW_LENSFILTER=YES

# Frame component visibility
#Default YES
SHOW_FRAME_COMPONENT=YES

# Corridor field visibility in Product Category component
#Default YES
SHOW_CORRIDOR=NO

# Show Field 'Other' in Product
#Default YES
SHOW_OTHER_FIELD=NO

# Material field enable/disable in Product Category component
#Default YES
MATERIAL_ENABLED=YES

# Available options: NONE, PROGLEN
#Default NONE
CORR_MODE=PROGLEN

# The Index must be same on both sides
#Default NO
BOTH_SAME_IDX=NO

# Show 'In Selection' Checkbox in Producfilter
#Default YES
SEARCH_WITH_FILTER=YES

#Default NO
LENS_ORDER_CONFIGURATION_ENTRYUSER=NO

#Show Edge Pinbevel in Form and geometry
# Default YES
SHOW_EDGE_PINBEVEL=YES

#Show Bevel position in Form and geometry
# Default YES
SHOW_BEVEL_POSITION=YES

#Show Polish in Form and geometry
# Default YES
SHOW_POLISH=NO

SETOPTIMIZED=YES

#In case of Database has wrong encoding = YES
UTF8_DECODE=NO